generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  assignedWorkOrders WorkOrder[] @relation("assignee")
  createdWorkOrders  WorkOrder[] @relation("creator")

  @@map("users")
}

/// seats_taken is only ever changed by the conditional updates in BookingsService.
/// The migration adds CHECK (seats_taken BETWEEN 0 AND capacity) as a last line of defence.
model Event {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  venue       String
  startsAt    DateTime @map("starts_at") @db.Timestamptz(3)
  capacity    Int
  seatsTaken  Int      @default(0) @map("seats_taken")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  bookings   Booking[]
  workOrders WorkOrder[]

  @@index([startsAt])
  @@map("events")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  /// Source of the human reference ("VD-7K2Q9X"), see booking-reference.ts.
  seq            Int           @unique @default(autoincrement())
  eventId        String        @map("event_id") @db.Uuid
  name           String
  email          String
  seats          Int
  status         BookingStatus @default(CONFIRMED)
  idempotencyKey String        @unique @map("idempotency_key") @db.Uuid
  /// Hash of the request that created the booking, to tell a retry from a reused key.
  payloadHash    String        @map("payload_hash")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId, seq])
  @@map("bookings")
}

model WorkOrder {
  id          String            @id @default(uuid()) @db.Uuid
  /// Source of the human number ("WO-0001").
  seq         Int               @unique @default(autoincrement())
  title       String
  description String
  priority    WorkOrderPriority
  status      WorkOrderStatus   @default(OPEN)
  eventId     String?           @map("event_id") @db.Uuid
  assigneeId  String?           @map("assignee_id") @db.Uuid
  createdById String            @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  event     Event? @relation(fields: [eventId], references: [id])
  assignee  User?  @relation("assignee", fields: [assigneeId], references: [id])
  createdBy User   @relation("creator", fields: [createdById], references: [id])

  @@index([status])
  @@index([assigneeId])
  @@index([eventId])
  @@index([createdById])
  @@map("work_orders")
}
