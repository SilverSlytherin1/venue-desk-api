# Copy to .env for local development (npm run start:dev). Demo values only: never reuse them.
# The API refuses to start if any of these is missing or malformed, see src/config/env.ts.

NODE_ENV=development
PORT=3000

# Matches the "db" service of docker-compose.yml as seen from the host.
DATABASE_URL=postgresql://venue_desk:venue_desk@localhost:5433/venue_desk

# At least 32 characters. Generate a real one with: openssl rand -base64 48
# This value is public. With NODE_ENV=production the API rejects it unless DEMO_MODE=true.
JWT_SECRET=demo-only-jwt-secret-do-not-use-in-production
JWT_TTL_SECONDS=3600

# Comma separated origins allowed by CORS, each without a path.
CORS_ORIGIN=http://localhost:4200

# Number of reverse proxies in front of the API whose X-Forwarded-For is trusted. 0 means none.
TRUST_PROXY_HOPS=0

# Requests per client IP per minute.
LOGIN_RATE_LIMIT=5
BOOKING_RATE_LIMIT=10

# Optional. Database used by `npm run test:e2e`. It is created on demand and truncated between tests.
# E2E_DATABASE_URL=postgresql://venue_desk:venue_desk@localhost:5433/venue_desk_e2e
